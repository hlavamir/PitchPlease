// PitchPls! discoball -- stepper bring-up test
//
// Spins the motor continuously in one direction, with shaft RPM breathing
// sinusoidally between 1 and 3 RPM (10s period) -- i.e. speed = baseline +
// amplitude*sin(...), kept strictly positive so it never crosses zero.
//
// NOTE: an earlier version of this test used a sine centered on zero
// (+/-3 RPM), which is a pendulum motion, not a spin -- a speed profile
// symmetric around zero has zero net rotation per period by construction
// (integrates to a small swing forward, then the same swing back). That's
// what "clicks to one position and back" was: working as written, just not
// as intended. This version keeps the sine strictly on one side of zero.
//
// This is a bench test of the motor+driver alone -- it does NOT go through the
// ring-gear reduction, so RPM here is motor-shaft RPM, not final ball RPM.
// See wiki/discoball.md for the wiring this assumes and the mechanical design.
//
// Wiring (see wiki/discoball.md):
//   STEP -> GPIO27
//   DIR  -> GPIO26
//   EN   -> GPIO19   (active LOW)
//   TMC2209 TX+RX jumpered together on the module, then -> 1k resistor -> GPIO21
//   MS1, MS2, CLK    -> GND
//   VIO              -> ESP32 3.3V
//   VM + motor GND   -> separate 12V PSU (NOT powered by the ESP32's USB cable --
//                       USB only powers the logic side; the motor coils need the
//                       external 12V rail connected too, or nothing will turn)

#include <Arduino.h>
#include <HardwareSerial.h>
#include <TMCStepper.h>
#include <AccelStepper.h>

// ---- Pins ----
constexpr uint8_t STEP_PIN = 27;
constexpr uint8_t DIR_PIN  = 26;
constexpr uint8_t EN_PIN   = 19;   // active LOW
constexpr uint8_t UART_PIN = 21;   // single wire: same GPIO used for both RX and TX

// ---- Driver config ----
constexpr uint32_t UART_BAUD      = 115200;
constexpr uint8_t  DRIVER_ADDRESS = 0b00;    // MS1=MS2=GND -> UART address 0
// R_SENSE is an ASSUMED value (0.11 ohm, the common default across most TMC2209
// clones) -- this board's own listing/datasheet doesn't document its actual sense
// resistor (see wiki/discoball.md). rms_current() below will be off proportionally
// if the real value differs; verify motor current with a multimeter if it matters.
constexpr float    R_SENSE        = 0.11f;
constexpr uint16_t RMS_CURRENT_MA = 800;     // conservative, under the motor's 1A/phase rating
constexpr uint16_t MICROSTEPS     = 16;

HardwareSerial driverSerial(1);
TMC2209Stepper driver(&driverSerial, R_SENSE, DRIVER_ADDRESS);
AccelStepper stepper(AccelStepper::DRIVER, STEP_PIN, DIR_PIN);

// ---- Motion profile: continuous spin, RPM breathing between BASELINE-AMPLITUDE
// and BASELINE+AMPLITUDE. Keep AMPLITUDE <= BASELINE so speed never crosses zero.
constexpr float STEPS_PER_REV       = 200.0f * MICROSTEPS; // 1.8 deg/step motor
constexpr float SPEED_BASELINE_RPM  = 2.0f;
constexpr float SPEED_AMPLITUDE_RPM = 1.0f; // -> oscillates 1..3 RPM
constexpr float PERIOD_S            = 10.0f;

void setup() {
  Serial.begin(115200);
  delay(500);
  Serial.println();
  Serial.println("--- Discoball stepper test: sine speed sweep ---");

  pinMode(EN_PIN, OUTPUT);
  digitalWrite(EN_PIN, HIGH); // driver disabled (active LOW) while we configure it

  // Single-wire UART: TX and RX are jumpered together on the module, so the ESP32
  // side also uses one GPIO for both directions.
  driverSerial.begin(UART_BAUD, SERIAL_8N1, UART_PIN, UART_PIN);
  driver.begin();

  if (driver.test_connection() == 0) {
    Serial.println("TMC2209 UART: OK");
  } else {
    Serial.println("TMC2209 UART: NOT RESPONDING -- check the TX/RX jumper + "
                    "1k resistor wiring to GPIO21, and that VIO/GND are connected.");
  }

  driver.toff(4);                 // enables the driver's output stage
  driver.rms_current(RMS_CURRENT_MA);
  driver.microsteps(MICROSTEPS);
  driver.pwm_autoscale(true);     // required for good StealthChop behaviour
  driver.en_spreadCycle(false);   // stay in StealthChop (silent) for this speed range

  stepper.setMaxSpeed(20000);        // steps/sec ceiling, generous headroom
  stepper.setAcceleration(4000);     // unused by runSpeed(), harmless to set
  stepper.setEnablePin(EN_PIN);
  stepper.setPinsInverted(false, false, true); // EN is active LOW
  stepper.enableOutputs();

  Serial.println("Setup complete. Spinning, 1..3 RPM breathing (motor shaft), 10s period.");
}

void loop() {
  float t   = millis() / 1000.0f;
  float rpm = SPEED_BASELINE_RPM + SPEED_AMPLITUDE_RPM * sinf(2.0f * PI * t / PERIOD_S);

  float stepsPerSec = (rpm / 60.0f) * STEPS_PER_REV;

  stepper.setSpeed(stepsPerSec);
  stepper.runSpeed(); // must be called as often as possible -- no delay() in loop()
}
