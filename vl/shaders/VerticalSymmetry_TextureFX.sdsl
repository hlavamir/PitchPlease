[Category("Filter")]
[Summary("")]
shader VerticalSymmetry_TextureFX : FilterBase
{
    float4 Filter(float4 tex0col)
    {
        float2 uv = streams.TexCoord;

        //uv.r = max(uv.r, 1 - uv.r);

        float2 uv2 = uv;
        uv2.r = 1- uv.r;

        float4 c = Texture0.Sample(Sampler0, uv);
        float4 d = Texture0.Sample(Sampler0, uv2);

        return lerp(c, d, 0.5);
    }
};